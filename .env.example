# SiteFlow backend configuration — copy the values you need into your shell profile,
# IDE run configuration, or process manager. Spring Boot reads these as OS environment
# variables (this project does not load a .env file automatically); there is no
# framework here that parses this file for you — it exists purely as documentation of
# what src/main/resources/application.yml expects.
#
# Do not put real secrets in this file. Copy the ones you need elsewhere and fill in
# your own local values there instead.

# MySQL connection (see application.yml -> spring.datasource)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=siteflow
DB_USERNAME=root
# No default is provided for DB_PASSWORD — the app will fail to start until you set
# it to your local MySQL user's password.
DB_PASSWORD=

# Port the Spring Boot API listens on (see application.yml -> server.port)
SERVER_PORT=8080

# JWT signing secret (HMAC-SHA256, minimum 256 bits / 32 characters)
# No default is provided — the app will fail to start until configured.
JWT_SECRET=
# JWT token validity in milliseconds (default: 3600000 = 1 hour)
JWT_EXPIRATION_MS=3600000

