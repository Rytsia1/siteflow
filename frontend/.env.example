# SiteFlow frontend configuration. Vite loads .env files in this directory
# automatically (.env, .env.local, .env.[mode], etc.) — copy this file to
# .env.local (gitignored) if you need to override the default.
#
# Only the backend host/port used by the dev server's /api proxy is
# configurable here; the app itself always calls the relative /api path
# (see src/api/http.js), so no other URLs need to be set for local dev.

# Where `npm run dev` proxies /api requests to. Defaults to http://localhost:8080
# if unset, matching the backend's default SERVER_PORT.
VITE_API_PROXY_TARGET=http://localhost:8080

# Axios request timeout in milliseconds. Defaults to 15000 (15s) if unset.
VITE_API_TIMEOUT=15000
